  - kind: 2
    value: select * from SALES1;
    languageId: oracle-sql
  - kind: 2
    value: |
      CREATE TABLE customer_lists(
          list_id NUMBER GENERATED BY DEFAULT AS IDENTITY,
          first_name varchar2(255) NOT NULL,
          last_name varchar2(255) NOT NULL,
          email varchar2(255) NOT NULL,
          sent NUMBER(1) NOT NULL,
          sent_date DATE,
          PRIMARY KEY(list_id)
      );
    languageId: oracle-sql
  - kind: 2
    value: select * from customer_lists;
    languageId: oracle-sql
  - kind: 2
    value: select * from ORDERS;
    languageId: oracle-sql
  - kind: 2
    value: select * from products;
    languageId: oracle-sql
  - kind: 2
    value: >-
      SELECT

      product_name,

      CASE
          WHEN LENGTH(description) > 58 THEN CONCAT(SUBSTR(description, 1, 50), '...')
          ELSE description
      END product_excerpt

      FROM
          products
      ORDER BY
          product_name;
    languageId: oracle-sql
  - kind: 2
    value: select * from articles;
    languageId: oracle-sql
  - kind: 2
    value: |-
      INSERT INTO articles (title, article_body)
      VALUES ('Sample article', 'This is a <strong>sample</strong> article');
    languageId: oracle-sql
  - kind: 2
    value: >-
      INSERT INTO articles( title, article_body)

      VALUES('Another article', 'Another excellent <strong>sample</strong>
      article');
    languageId: oracle-sql
